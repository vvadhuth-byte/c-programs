#include <stdio.h>

int main() {
   int a,b,i,j;
   int max=0,max2=0;
   scanf("%d %d",&a,&b);
   int arr[a][b];
   for(i=0;i<a;i++){
       for(j=0;j<b;j++){
           scanf("%d",&arr[i][j]);
       }
   }
   for(i=0;i<a;i++){
       for(j=0;j<a;j++){
           if(arr[i][j]>max){
               max=arr[i][j];
           }
           
       }
   }
   for(i=0;i<a;i++){
       for(j=0;j<a;j++){
           if(arr[i][j]>max2 && arr[i][j]!=max){
               max2=arr[i][j];
           }
           
       }
   }
   printf("%d",max2);
    return 0;
}
